{
  "manifest_version": 3,
  "name": "DeckGrab",
  "version": "1.0.0",
  "description": "Yoink flashcards from Quizlet sets straight into DeckGrab. One-click — no bookmarklet, no install dance.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://quizlet.com/*"],
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Yoink this set into DeckGrab",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://quizlet.com/*", "https://www.quizlet.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
